{
  "watchlist": ["BTCUSD", "ETHUSD", "SOLUSD"],
  "defaultTimeframe": "60",
  "interval": 60,

  "notifications": {
    "console": {
      "enabled": true
    },
    "telegram": {
      "enabled": false,
      "botToken": "your-telegram-bot-token",
      "chatId": "your-chat-id"
    },
    "webhook": {
      "enabled": false,
      "url": "https://your-webhook-url",
      "method": "POST",
      "headers": {}
    },
    "email": {
      "enabled": false,
      "smtpHost": "smtp.example.com",
      "smtpPort": 587,
      "smtpUser": "user@example.com",
      "smtpPass": "password",
      "from": "monitor@example.com",
      "to": "your-email@example.com"
    },
    "dingtalk": {
      "enabled": false,
      "webhookUrl": "https://oapi.dingtalk.com/robot/send?access_token=your-token",
      "secret": "your-sign-secret"
    }
  },

  "indicatorAlerts": {
    "BTCUSD": [
      {
        "name": "rsi-overbought",
        "indicator": "Relative Strength Index",
        "field": "RSI",
        "condition": "above",
        "threshold": 70,
        "cooldown": 300000
      },
      {
        "name": "rsi-oversold",
        "indicator": "Relative Strength Index",
        "field": "RSI",
        "condition": "below",
        "threshold": 30,
        "cooldown": 300000
      },
      {
        "name": "rsi-rising",
        "indicator": "Relative Strength Index",
        "field": "RSI",
        "condition": "rising",
        "cooldown": 60000
      },
      {
        "name": "macd-between",
        "indicator": "MACD",
        "field": "MACD",
        "condition": "between",
        "min": -0.5,
        "max": 0.5,
        "cooldown": 300000
      }
    ],
    "ETHUSD": [
      {
        "name": "rsi-cross-50-up",
        "indicator": "Relative Strength Index",
        "field": "RSI",
        "condition": "cross_above",
        "threshold": 50,
        "cooldown": 300000
      },
      {
        "name": "rsi-cross-50-down",
        "indicator": "Relative Strength Index",
        "field": "RSI",
        "condition": "cross_below",
        "threshold": 50,
        "cooldown": 300000
      }
    ]
  },

  "crossIndicatorAlerts": {
    "BTCUSD": [
      {
        "name": "macd-golden-cross",
        "indicator1": "MACD",
        "field1": "MACD",
        "indicator2": "MACD",
        "field2": "Signal",
        "condition": "cross_above",
        "cooldown": 600000
      },
      {
        "name": "macd-death-cross",
        "indicator1": "MACD",
        "field1": "MACD",
        "indicator2": "MACD",
        "field2": "Signal",
        "condition": "cross_below",
        "cooldown": 600000
      },
      {
        "name": "price-above-ema20",
        "indicator1": "Moving Average Exponential",
        "field1": "EMA",
        "indicator2": "Moving Average Exponential",
        "field2": "EMA",
        "condition": "above",
        "cooldown": 300000
      }
    ],
    "ETHUSD": [
      {
        "name": "ema5-above-ema20",
        "indicator1": "Moving Average Exponential",
        "field1": "EMA",
        "indicator2": "Moving Average Exponential",
        "field2": "EMA",
        "condition": "cross_above",
        "cooldown": 600000
      }
    ]
  },

  "multiConditionAlerts": {
    "BTCUSD": [
      {
        "name": "bullish-setup",
        "logic": "all",
        "conditions": [
          {
            "indicator": "Relative Strength Index",
            "field": "RSI",
            "condition": "above",
            "threshold": 50
          },
          {
            "indicator": "MACD",
            "field": "Histogram",
            "condition": "above",
            "threshold": 0
          }
        ],
        "cooldown": 600000
      },
      {
        "name": "oversold-with-volume",
        "logic": "any",
        "conditions": [
          {
            "indicator": "Relative Strength Index",
            "field": "RSI",
            "condition": "below",
            "threshold": 25
          },
          {
            "indicator": "Stochastic",
            "field": "%K",
            "condition": "below",
            "threshold": 20
          }
        ],
        "cooldown": 600000
      }
    ]
  }
}
